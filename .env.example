# 应用
APP_NAME=煤炉骏合屋商品监控
APP_ENV=production
SECRET_KEY=please-change-this-to-a-long-random-string
# 可选：Fernet key（python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"）
# 若不设置，将从 SECRET_KEY 派生（开发可用，生产建议显式设置）
CREDENTIALS_FERNET_KEY=

# 数据库（默认 SQLite；也可换成 PostgreSQL）
DATABASE_URL=sqlite:////workspace/data/monitor.db
# DATABASE_URL=postgresql+psycopg://monitor:monitor@db:5432/monitor

# CORS（前端独立开发时）
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# 调度与请求控制
SCHEDULER_ENABLED=true
DEFAULT_CHECK_INTERVAL_SECONDS=60
MIN_CHECK_INTERVAL_SECONDS=30
MAX_CONCURRENT_PLATFORM_REQUESTS=3
REQUEST_TIMEOUT_SECONDS=20
MAX_ITEMS_PER_SEARCH=30
PLATFORM_MIN_INTERVAL_SECONDS=1.5
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_SECONDS=2

# 出站 User-Agent（标明用途，勿伪装成浏览器绕过访问控制）
HTTP_USER_AGENT=JP-Monitor/1.0 (+https://github.com/thanhluongle2018-spec/sir; personal monitoring)

# 前端静态资源目录（Docker 中自动设置）
# STATIC_DIR=/app/frontend/dist

# —— 可插拔数据源（可选）——
# 用户主动入库商品 JSON（空则 /api/ingest 禁用）
INGEST_API_TOKEN=

# 官方邮件提醒数据源：仅 OAuth，禁止邮箱密码（当前脚手架未启用读取）
EMAIL_OAUTH_PROVIDER=
EMAIL_OAUTH_CLIENT_ID=
EMAIL_OAUTH_CLIENT_SECRET=
EMAIL_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/oauth/email/callback
